# URL publica del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# PayPhone
PAYPHONE_TOKEN=your-token
PAYPHONE_STORE_ID=your-store-id
PAYPHONE_TAX_MODE=tax_included
PAYPHONE_TAX_RATE=15

# Secreto largo y aleatorio que el reconciliador programado envía como Bearer.
# Debe existir con el mismo valor en producción y como secret CRON_SECRET en GitHub.
CRON_SECRET=replace-with-at-least-32-random-characters

# HMAC independiente para anonimizar identificadores del rate limiter.
# En Preview y Production debe contener al menos 32 bytes aleatorios.
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# hCaptcha
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-site-key
